        "message": "= <!DOCTYPE html> <html lang=\"es\"> <head>   <meta charset=\"UTF-8\">   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">   <title>Nuevo reclamo recibido</title> </head>  <body style=\"margin:0; padding:30px 10px; background-color:#f4f6f9; font-family:Arial, Helvetica, sans-serif; color:#263445;\">    <div style=\"max-width:650px; margin:0 auto; background:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #e5eaf0;\">      <!-- Encabezado -->     <div style=\"background:#172b4d; padding:28px 30px; color:#ffffff;\">       <div style=\"font-size:12px; letter-spacing:2px; color:#a9bdd8; text-transform:uppercase; margin-bottom:12px;\">         Sistema de atención al cliente       </div>        <h1 style=\"margin:0; font-size:24px; font-weight:700;\">         Nuevo reclamo recibido       </h1>        <p style=\"margin:10px 0 0; color:#d5dfec; font-size:14px; line-height:1.6;\">         Se ha registrado una nueva solicitud que requiere revisión y seguimiento.       </p>     </div>      <!-- Alerta -->     <div style=\"padding:20px 30px 0;\">       <div style=\"background:#fff4e5; border-left:4px solid #ed9b27; padding:14px 16px; border-radius:5px;\">         <div style=\"font-size:14px; font-weight:bold; color:#a65b00;\">           Atención requerida         </div>         <div style=\"font-size:13px; color:#805b32; margin-top:5px;\">           Nivel de urgencia: {{ $json.output.urgencia }}         </div>       </div>     </div>      <!-- Información del cliente -->     <div style=\"padding:25px 30px 10px;\">       <h2 style=\"font-size:16px; color:#172b4d; margin:0 0 16px;\">         Información del cliente       </h2>        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size:14px; border-collapse:collapse;\">         <tr>           <td style=\"padding:11px 0; color:#718096; width:110px; border-bottom:1px solid #edf0f4;\">             Cliente           </td>           <td style=\"padding:11px 0; font-weight:bold; border-bottom:1px solid #edf0f4;\">             {{ $('On form submission').item.json.nombre }}           </td>         </tr>          <tr>           <td style=\"padding:11px 0; color:#718096; border-bottom:1px solid #edf0f4;\">             Correo           </td>           <td style=\"padding:11px 0; border-bottom:1px solid #edf0f4;\">             {{ $('On form submission').item.json.correo }}           </td>         </tr>          <tr>           <td style=\"padding:11px 0; color:#718096;\">             Tema           </td>           <td style=\"padding:11px 0; font-weight:bold;\">             {{ $json.output.tema }}           </td>         </tr>       </table>     </div>      <!-- Reclamo -->     <div style=\"padding:15px 30px;\">       <h2 style=\"font-size:16px; color:#172b4d; margin:0 0 12px;\">         Detalle del reclamo       </h2>        <div style=\"background:#f7f9fc; border:1px solid #e8edf3; padding:18px; border-radius:8px; font-size:14px; line-height:1.7; color:#465568;\">         {{ $('On form submission').item.json.reclamo }}       </div>     </div>      <!-- Respuesta sugerida -->     <div style=\"padding:15px 30px 30px;\">       <h2 style=\"font-size:16px; color:#172b4d; margin:0 0 12px;\">         Respuesta sugerida al cliente       </h2>        <div style=\"background:#eef6ff; border:1px solid #d6e8fb; border-radius:8px; padding:20px;\">         <div style=\"font-size:12px; color:#3974b8; font-weight:bold; text-transform:uppercase; letter-spacing:1px; margin-bottom:10px;\">           Propuesta generada por el sistema         </div>          <div style=\"font-size:14px; line-height:1.8; color:#344b65;\">           {{ $json.output.respuesta_cliente }}         </div>       </div>     </div>      <!-- Pie -->     <div style=\"background:#f7f9fc; border-top:1px solid #e8edf3; padding:20px 30px; text-align:center;\">       <p style=\"margin:0; font-size:12px; color:#718096; line-height:1.6;\">         Notificación automática generada por el sistema de gestión de reclamos.         <br>         Se recomienda revisar la información y validar la respuesta antes de enviarla al cliente.       </p>     </div>    </div>  </body> </html>",
